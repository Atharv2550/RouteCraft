{
  "name": "routecraft",
  "version": "1.0.0",
  "description": "RouteCraft — Complete MERN Stack Trip Planning & Collaboration Platform",
  "private": true,
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm --prefix server test && npm --prefix client test"
  },
  "keywords": [
    "travel",
    "itinerary",
    "trip-planner",
    "collaboration",
    "mern"
  ],
  "author": "RouteCraft Team",
  "license": "ISC"
}
